---
import { currentLocale, t } from "@/lib/i18n";
export const CAL_URL = "https://cal.com/thibault-mthh/consulting-1-1";
const s = t(currentLocale(Astro)).cta;
const ctas = [
  { href: "https://genlook.app", ...s.genlook },
  { href: CAL_URL, ...s.call },
];
---
<div class="mt-8 grid sm:grid-cols-2 gap-3">
  {ctas.map((c) => (
    <a href={c.href} target="_blank" rel="noopener" class="group block rounded-lg bg-surface p-4">
      <div class="font-medium group-hover:text-accent">{c.title} <span aria-hidden="true">↗</span></div>
      <p class="mt-1 text-[15px] text-muted">{c.text}</p>
    </a>
  ))}
</div>
