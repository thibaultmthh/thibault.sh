---
import { isExternal, linkLabel, type Project } from "@/lib/projects";
import { currentLocale, localePath, t } from "@/lib/i18n";
interface Props { p: Project }
const { p } = Astro.props;
const locale = currentLocale(Astro);
const s = t(locale).projects;
// Internal page links (blog posts) follow the page's locale; external URLs and files are left alone.
const localize = (href: string) => (href.startsWith("/") && !isExternal(href) ? localePath(href, locale) : href);
const links = [...(p.href ? [{ label: linkLabel(p.href, locale), href: localize(p.href) }] : []), ...(p.links ?? []).map((l) => ({ ...l, href: localize(l.href) }))];
---
<li class="py-3">
  <div class="flex flex-wrap items-baseline gap-x-2">
    <span class="font-medium">{p.name}</span>
    <span class="text-[15px] text-muted tabular-nums">{p.year}</span>
    {p.status === "active" && <span class="text-[14px] text-accent">● {s.live}</span>}
  </div>
  <p class="text-muted mt-0.5">{p.description}</p>
  {links.length > 0 && (
    <p class="mt-1 flex flex-wrap gap-x-4 text-[15px]">
      {links.map((l) => (
        <a
          href={l.href}
          class="underline decoration-rule underline-offset-4 hover:text-accent hover:decoration-accent"
          target={isExternal(l.href) ? "_blank" : undefined}
          rel={isExternal(l.href) ? "noopener" : undefined}
        >{l.label} {isExternal(l.href) ? "↗" : "→"}</a>
      ))}
    </p>
  )}
</li>
