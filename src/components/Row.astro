---
// Title + optional one-line description, with a muted meta line (date, reading time).
interface Props { href: string; title: string; meta?: string; description?: string }
const { href, title, meta, description } = Astro.props;
---
<li>
  <a href={href} class="group block py-3">
    <span class="font-medium group-hover:text-accent">{title}</span>
    {description && <span class="block text-muted mt-0.5">{description}</span>}
    {meta && <span class="block text-[15px] text-muted mt-0.5">{meta}</span>}
  </a>
</li>
