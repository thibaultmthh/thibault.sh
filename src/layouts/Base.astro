---
import "@/styles/global.css";
import { LOCALES, LOCALE_NAMES, allAlternates, cleanPath, currentLocale, localePath, splitLocale, t } from "@/lib/i18n";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Canonical site-relative path; defaults to the current page. */
  canonicalPath?: string;
  /** hreflang map (locale → path); defaults to this page in every locale. */
  alternates?: Record<string, string>;
}
const SITE = "Thibault Mathian";
const locale = currentLocale(Astro);
const s = t(locale);
const pagePath = cleanPath(Astro.url.pathname);
const { path } = splitLocale(pagePath);
const {
  title,
  description = s.siteDesc,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex,
  canonicalPath = pagePath,
  alternates = allAlternates(path),
} = Astro.props;
const fullTitle = title ? `${title} — thibault.sh` : SITE;
const canonical = new URL(canonicalPath, Astro.site);
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const GA_ON = import.meta.env.PUBLIC_GA_ENABLED === "true" && !!GA_ID;
const l = (p: string) => localePath(p, locale);

const nav = [
  { href: l("/blog"), label: s.nav.blog },
  { href: l("/projects"), label: s.nav.projects },
  { href: l("/contact"), label: s.nav.contact },
];
const socials = [
  { href: "https://github.com/thibaultmthh", label: "github" },
  { href: "https://twitter.com/thibault_mthh", label: "x" },
  { href: "https://www.linkedin.com/in/thibault-mathian/", label: "linkedin" },
  { href: "mailto:dev@thibault.sh", label: "email" },
];
// The switcher always offers every locale: every page exists in every locale
// (blog posts fall back to English until translated).
const switcher = LOCALES.map((code) => ({ code, href: localePath(path, code), label: LOCALE_NAMES[code] ?? code }));
const hreflangs = Object.entries(alternates).filter(([code]) => LOCALES.includes(code));
const xDefault = alternates[LOCALES[0]] ?? alternates.en;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && hreflangs.map(([code, href]) => <link rel="alternate" hreflang={code} href={new URL(href, Astro.site)} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Thibault Mathian" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/GeistVF.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/GeistMonoVF.woff" as="font" type="font/woff" crossorigin />
    <meta property="og:site_name" content="thibault.sh" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace("-", "_")} />
    <meta property="og:image" content={new URL("/og-banner.png", Astro.site)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@thibault_mthh" />
    {
      GA_ON && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="w-full max-w-2xl mx-auto px-5 flex-1 flex flex-col">
      <header class="flex items-center justify-between gap-4 h-12 border-b border-rule text-[15px]">
        <a href={l("/")} class="font-semibold tracking-tight hover:text-accent">thibault.sh</a>
        <nav class="flex gap-5">
          {nav.map((n) => <a href={n.href} class="text-muted hover:text-ink">{n.label}</a>)}
        </nav>
      </header>
      <main class="flex-1 py-8"><slot /></main>
      <footer class="border-t border-rule py-4 text-[13px] text-muted">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span>
            © {new Date().getFullYear()} Thibault Mathian
            <span class="mx-2">·</span>
            {s.footer.poweredBy} <a href="https://scribe.genlook.app" class="underline decoration-rule hover:text-ink" target="_blank" rel="noopener">Scribe CMS</a>
          </span>
          <nav class="flex gap-3">
            {socials.map((so) => <a href={so.href} class="hover:text-ink" target="_blank" rel="noopener">{so.label}</a>)}
            <a href="/feed.xml" class="hover:text-ink">{s.footer.rss}</a>
          </nav>
        </div>
        <nav aria-label={s.footer.language} class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
          {switcher.map((o) => (
            <a
              href={o.href}
              hreflang={o.code}
              lang={o.code}
              data-set-locale={o.code}
              aria-current={o.code === locale ? "page" : undefined}
              class:list={["hover:text-ink", { "text-ink": o.code === locale }]}
            >{o.label}</a>
          ))}
        </nav>
      </footer>
    </div>
    <script is:inline>
      // Remember an explicit language choice so the edge redirect on "/" honours it
      // (see vercel.json) instead of the browser's Accept-Language.
      document.addEventListener("click", (e) => {
        const a = e.target && e.target.closest && e.target.closest("[data-set-locale]");
        if (!a) return;
        document.cookie = "locale=" + a.dataset.setLocale + "; path=/; max-age=31536000; samesite=lax";
      });
    </script>
  </body>
</html>
