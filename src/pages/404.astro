---
import Base from "@/layouts/Base.astro";
import { DEFAULT_LOCALE, t } from "@/lib/i18n";
const s = t(DEFAULT_LOCALE).notFound;
---
<Base title={s.title} noindex>
  <h1 class="text-2xl font-semibold tracking-tight">404</h1>
  <p class="text-muted mt-1">{s.text}</p>
  <a href="/" class="inline-block mt-4 underline decoration-muted hover:text-accent">{s.home}</a>
</Base>
