---
import Base from "@/layouts/Base.astro";
import Row from "@/components/Row.astro";
import readingTime from "reading-time";
import { getPosts, fmtDate, postPath } from "@/lib/blog";
import { currentLocale, fmt, localeStaticPaths, t } from "@/lib/i18n";

export const getStaticPaths = localeStaticPaths;

const locale = currentLocale(Astro);
const s = t(locale).blog;
const posts = getPosts(locale);
const minutes = (content: string) => Math.max(1, Math.ceil(readingTime(content).minutes));
---
<Base title={s.title} description={s.desc}>
  <h1 class="text-2xl font-semibold tracking-tight">{s.title}</h1>
  <p class="text-muted mt-1">{s.desc}</p>
  <ul class="mt-6 border-t border-rule">
    {posts.map((p) => (
      <Row href={postPath(p.slug, locale)} meta={fmtDate(p.date)} title={p.title} aside={fmt(s.minRead, { n: minutes(p.content) })} description={p.description} />
    ))}
  </ul>
</Base>
