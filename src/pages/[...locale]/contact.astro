---
import Base from "@/layouts/Base.astro";
import { CAL_URL } from "@/components/Cta.astro";
import { currentLocale, localeStaticPaths, t } from "@/lib/i18n";

export const getStaticPaths = localeStaticPaths;

const s = t(currentLocale(Astro)).contact;
const rows = [
  { href: "mailto:dev@thibault.sh", label: s.email, value: "dev@thibault.sh" },
  { href: CAL_URL, label: s.call, value: s.callValue },
  { href: "https://github.com/thibaultmthh", label: "github", value: "github.com/thibaultmthh" },
  { href: "https://twitter.com/thibault_mthh", label: "x", value: "twitter.com/thibault_mthh" },
  { href: "https://www.linkedin.com/in/thibault-mathian/", label: "linkedin", value: "linkedin.com/in/thibault-mathian" },
];
---
<Base title={s.title}>
  <h1 class="text-2xl font-semibold tracking-tight">{s.title}</h1>
  <p class="text-muted mt-1 max-w-[52ch]">{s.desc}</p>
  <ul class="mt-6 border-t border-rule">
    {rows.map((r) => (
      <li class="border-b border-rule">
        <a href={r.href} class="group flex items-baseline gap-3 py-3 hover:text-accent" target={r.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
          <span class="w-[5.5rem] shrink-0 font-mono text-[13px] text-muted">{r.label}</span>
          <span>{r.value} ↗</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
