---
import Base from "@/layouts/Base.astro";
import Cta from "@/components/Cta.astro";
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import { getPosts, fmtDate, postPath } from "@/lib/blog";
import { getProjects } from "@/lib/projects";
import { currentLocale, localePath, localeStaticPaths, t } from "@/lib/i18n";

export const getStaticPaths = localeStaticPaths;

const locale = currentLocale(Astro);
const s = t(locale);
const posts = getPosts(locale).slice(0, 4);
const featured = getProjects(locale).slice(0, 5);
const socials = [
  { href: "https://github.com/thibaultmthh", label: "github" },
  { href: "https://twitter.com/thibault_mthh", label: "x" },
  { href: "https://www.linkedin.com/in/thibault-mathian/", label: "linkedin" },
  { href: "mailto:dev@thibault.sh", label: "email" },
];
---
<Base>
  <h1 class="text-2xl font-semibold tracking-tight">Thibault Mathian</h1>
  <p class="text-muted mt-1 max-w-[52ch]">
    {s.home.taglineStart}<a href="https://genlook.app" class="text-ink underline decoration-muted hover:text-accent">Genlook</a>{s.home.taglineEnd}
  </p>
  <div class="mt-3 flex gap-4 text-[14px] text-muted">
    {socials.map((so) => <a href={so.href} class="hover:text-ink" target="_blank" rel="noopener">{so.label} ↗</a>)}
  </div>

  <Cta />

  <Section title={s.home.projects} href={localePath("/projects", locale)}>
    <ul class="border-t border-rule">
      {featured.map((p) => <ProjectRow p={p} />)}
    </ul>
  </Section>

  <Section title={s.home.writing} href={localePath("/blog", locale)}>
    <ul class="border-t border-rule">
      {posts.map((p) => <Row href={postPath(p.slug, locale)} meta={fmtDate(p.date)} title={p.title} />)}
    </ul>
  </Section>
</Base>
