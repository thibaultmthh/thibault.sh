---
import Base from "@/layouts/Base.astro";
import readingTime from "reading-time";
import { getPosts, fmtDate, type Post } from "@/lib/blog";
import { renderMarkdown } from "@/lib/markdown";

export function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const html = await renderMarkdown(post.content);
const stats = readingTime(post.content);
---
<Base title={post.title} description={post.description} type="article" publishedTime={post.date} modifiedTime={post.updatedAt}>
  <article>
    <header class="mb-8">
      <a href="/blog" class="text-[14px] text-muted hover:text-ink">← blog</a>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight leading-snug max-w-[40ch]">{post.title}</h1>
      <p class="mt-2 font-mono text-[13px] text-muted"><time datetime={post.date}>{fmtDate(post.date)}</time> · {stats.text}</p>
    </header>
    <div class="prose" set:html={html} />
  </article>
</Base>
