---
import Base from "@/layouts/Base.astro";
import { CAL_URL } from "@/components/Cta.astro";
const rows = [
  { href: "mailto:dev@thibault.sh", label: "email", value: "dev@thibault.sh" },
  { href: CAL_URL, label: "1:1 call", value: "book a slot on cal.com" },
  { href: "https://github.com/thibaultmthh", label: "github", value: "github.com/thibaultmthh" },
  { href: "https://twitter.com/thibault_mthh", label: "x", value: "twitter.com/thibault_mthh" },
  { href: "https://www.linkedin.com/in/thibault-mathian/", label: "linkedin", value: "linkedin.com/in/thibault-mathian" },
];
---
<Base title="Contact">
  <h1 class="text-2xl font-semibold tracking-tight">Contact</h1>
  <p class="text-muted mt-1 max-w-[52ch]">Partnerships, Genlook, or just a hello. Email is the fastest way.</p>
  <ul class="mt-6 border-t border-rule">
    {rows.map((s) => (
      <li class="border-b border-rule">
        <a href={s.href} class="group flex items-baseline gap-3 py-3 hover:text-accent" target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
          <span class="w-[5.5rem] shrink-0 font-mono text-[13px] text-muted">{s.label}</span>
          <span>{s.value} ↗</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
