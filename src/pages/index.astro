---
import Base from "@/layouts/Base.astro";
import Cta from "@/components/Cta.astro";
import Section from "@/components/Section.astro";
import Row from "@/components/Row.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import { getPosts, fmtDate } from "@/lib/blog";
import { getProjects } from "@/lib/projects";

const posts = getPosts().slice(0, 4);
const featured = getProjects().slice(0, 5);
const socials = [
  { href: "https://github.com/thibaultmthh", label: "github" },
  { href: "https://twitter.com/thibault_mthh", label: "x" },
  { href: "https://www.linkedin.com/in/thibault-mathian/", label: "linkedin" },
  { href: "mailto:dev@thibault.sh", label: "email" },
];
---
<Base>
  <h1 class="text-2xl font-semibold tracking-tight">Thibault Mathian</h1>
  <p class="text-muted mt-1 max-w-[52ch]">
    Founder, based in France. Building <a href="https://genlook.app" class="text-ink underline decoration-muted hover:text-accent">Genlook</a>, AI virtual try-on for Shopify.
  </p>
  <div class="mt-3 flex gap-4 text-[14px] text-muted">
    {socials.map((s) => <a href={s.href} class="hover:text-ink" target="_blank" rel="noopener">{s.label} ↗</a>)}
  </div>

  <Cta />

  <Section title="Projects" href="/projects">
    <ul class="border-t border-rule">
      {featured.map((p) => <ProjectRow p={p} />)}
    </ul>
  </Section>

  <Section title="Writing" href="/blog">
    <ul class="border-t border-rule">
      {posts.map((p) => <Row href={`/blog/${p.slug}`} meta={fmtDate(p.date)} title={p.title} />)}
    </ul>
  </Section>
</Base>
